# ---------------- Unity 生成物 ----------------
# 这些都是从 Assets 重新生成的，不进版本库
LOVE/[Ll]ibrary/
LOVE/[Tt]emp/
LOVE/[Oo]bj/
LOVE/[Bb]uild/
LOVE/[Bb]uilds/
LOVE/[Ll]ogs/
LOVE/[Uu]ser[Ss]ettings/
LOVE/[Mm]emoryCaptures/
LOVE/[Rr]ecordings/

# 自动生成的工程文件
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vsconfig

# 打包输出
Build/
*.apk
*.aab
*.unitypackage
*.app

# 崩溃日志
sysinfo.txt
crashlytics-build.properties

# ---------------- 大文件走 Git LFS ----------------
# 模型、视频、音频由 .gitattributes 交给 LFS 托管，不在这里排除。
# 单文件超 100 MB 的限制对 LFS 不适用。GitHub Free 的 LFS 额度是
# 10 GiB 存储 + 10 GiB/月流量，当前用掉约 1 GB。

# ---------------- 系统垃圾 ----------------
.DS_Store
Thumbs.db
desktop.ini
