# ---------------- Unity 生成物 ----------------
# 这些都是从 Assets 重新生成的，不进版本库
LOVE/[Ll]ibrary/
LOVE/[Tt]emp/
LOVE/[Oo]bj/
LOVE/[Bb]uild/
LOVE/[Bb]uilds/
LOVE/[Ll]ogs/
LOVE/[Uu]ser[Ss]ettings/
LOVE/[Mm]emoryCaptures/
LOVE/[Rr]ecordings/

# 自动生成的工程文件
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vsconfig

# 打包输出
Build/
*.apk
*.aab
*.unitypackage
*.app

# 崩溃日志
sysinfo.txt
crashlytics-build.properties

# ---------------- 超出 GitHub 限制的大文件 ----------------

# AI 模型共约 800 MB，其中三个单文件超过 GitHub 的 100 MB 硬上限。
# 都是可公开下载的第三方权重，用 Tools/fetch-models.sh 取回，不进版本库。
LOVE/Assets/GameAssets/Models/*.onnx
LOVE/Assets/GameAssets/Models/*.onnx.meta

# 测试视频约 180 MB，属于素材而非代码。
# 自己的片子放进去即可，文件名对上 story.json 里的 video 字段。
LOVE/Assets/StreamingAssets/Videos/*.mp4
LOVE/Assets/StreamingAssets/Videos/*.mp4.meta

# BGM 同理，属于素材
LOVE/Assets/Resources/Audio/BGM/*.ogg
LOVE/Assets/Resources/Audio/BGM/*.mp3
LOVE/Assets/Resources/Audio/BGM/*.wav
LOVE/Assets/Resources/Audio/BGM/*.ogg.meta
LOVE/Assets/Resources/Audio/BGM/*.mp3.meta
LOVE/Assets/Resources/Audio/BGM/*.wav.meta

# ---------------- 系统垃圾 ----------------
.DS_Store
Thumbs.db
desktop.ini
